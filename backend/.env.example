# ==============================================================================
# Banana Ganrajya — Backend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your production credentials.
# Do NOT commit the active '.env' file containing real secrets to source control.

# --- Database Configurations ---
DATABASE_URL=sqlite:///./banana.db

# --- Auth0 API Integration (JWT Token Validation & User Sync) ---
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id_here
AUTH0_CLIENT_SECRET=your_auth0_client_secret_here
AUTH0_AUDIENCE=your_auth0_audience_here

# --- Paytm Merchant Payments (Subscribers flow) ---
PAYTM_MERCHANT_ID=your_paytm_merchant_id_here
PAYTM_MERCHANT_KEY=your_paytm_merchant_key_here

# --- AWS Polly Speech Synthesis & S3 Bucket Storage ---
CLOUDFLARE_ACCESS_KEY_ID=abcd123
CLOUDFLARE_SECRET_ACCESS_KEY=abcd123
R2_BUCKET_NAME=abcbucket
R2_REGION=abcregion
R2_ENDPOINT=https://example.com/endpoint

# --- Administrator Publishing Portal Permissions ---
# The designated email of the single Auth0 administrator.
ADMIN_EMAIL=admin@banana.in

# Long-lived secret static API Key for direct form submissions (Copy from app settings)
ADMIN_API_KEY=secure_banana_admin_secret_key_2026
