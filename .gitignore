# ==============================================================================
# Banana Ganrajya — Comprehensive .gitignore
# Covers Flutter / Dart, Python FastAPI Backend, Android, iOS, Web, IDEs, and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials, & Environment Variables (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519

# Android Keystores & Properties
key.properties
*.keystore
*.jks
**/android/local.properties
**/android/key.properties

# Google Services / Firebase / Auth Configs with secret keys
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# Databases, Local Storage, & Backups
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.bak
*.backup
*.dump
backend/banana.db*

# ------------------------------------------------------------------------------
# Python & FastAPI Backend
# ------------------------------------------------------------------------------
# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.Python
*.so

# Virtual Environments
.venv/
venv/
venv_banana/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
.tox/
.nox/
htmlcov/

# ------------------------------------------------------------------------------
# Flutter / Dart
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
**/doc/api/
coverage/
custom_lint.log

# Flutter Obfuscation & Symbols
app.*.symbols
app.*.map.json

# iOS / Flutter ephemeral build outputs
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*

# macOS / Flutter ephemeral outputs
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.*

# Windows / Linux ephemeral outputs
**/windows/flutter/ephemeral/
**/windows/flutter/GeneratedPluginRegistrant.*
**/linux/flutter/ephemeral/
**/linux/flutter/GeneratedPluginRegistrant.*

# ------------------------------------------------------------------------------
# Android Platform
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/GeneratedPluginRegistrant.java
**/android/.cxx/
**/android/build/
**/android/app/build/
.gradle/

# ------------------------------------------------------------------------------
# iOS & macOS (Apple ecosystem)
# ------------------------------------------------------------------------------
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
**/DerivedData/
**/Pods/
**/.symlinks/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# ------------------------------------------------------------------------------
# IDEs, Editors, & Tooling
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / Android Studio / IntelliJ
.idea/
*.iml
*.iws
*.ipr
out/

# General editor temps & OS noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# Logs & Scratch
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
migrate_working_dir/

# skill for the AI agents
AUTH0_SKILLS
# Cloud log exports (may contain infra hostnames)
downloaded-logs-*.json
